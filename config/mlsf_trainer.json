{
    "dataset_kwargs":{
        "_type":"nuscenes",
        "kitti_dataset_kwargs":{
            "kitti_trainer_dataset_kwargs":{
                "lidar_dir":"data/KiTTi/training/velodyne",
                "calibration_dir":"data/KiTTi/training/calib",
                "left_image_dir":"data/KiTTi/training/image_2",
                "right_image_dir":null,
                "labels_dir":"data/KiTTi/training/label_2",
                "shuffle":false,
                "apply_augmentation":false, 
                "batch_size":8
            },
            "kitti_validation_dataset_kwargs":{
                "lidar_dir":"data/KiTTi/validation/velodyne",
                "calibration_dir":"data/KiTTi/validation/calib",
                "left_image_dir":"data/KiTTi/validation/image_2",
                "right_image_dir":null,
                "labels_dir":"data/KiTTi/validation/label_2",
                "shuffle":false,
                "apply_augmentation":false, 
                "batch_size":12            
            }
        }, 
        "nuscenes_dataset_kwargs":{
            "nuscenes_trainer_dataset_kwargs":{
                "root_dir":"data/nuscenes",
                "shuffle":true,
                "batch_size":12,
                "table_blob_paths":[
                    "data/nuscenes/trainval03_blobs_US/tables.json",                     
                    "data/nuscenes/trainval05_blobs_US/tables.json", 
                    "data/nuscenes/trainval06_blobs_US/tables.json",
                    "data/nuscenes/trainval07_blobs_US/tables.json"

                ]
            },
            "nuscenes_validation_dataset_kwargs":{
                "root_dir":"data/nuscenes",
                "shuffle":false,
                "batch_size":12,
                "table_blob_paths":[
                    "data/nuscenes/trainval04_blobs_US/tables.json", 
                    "data/nuscenes/trainval08_blobs_US/tables.json"
                ]
            }            
        },
        "image_resize":[608, 608], 
        "perform_validation":false, 
        "lidar_map_type":"bev_map"
    },
    "model_kwargs":{
        "model_type":"mlsf_yolov3",
        "mlsf_yolo_kwargs":{
            "image_cfg_file":"config/yolov3-nuscenes-608-numClasses-3.cfg",
            "lidar_cfg_file":"config/yolov3-nuscenes-608-numClasses-3.cfg",
            "yolov8_weights_path":"yolov8l.pt",
            "image_channels":3, 
            "lidar_channels":3, 
            "use_lidar_backbone":true,
            "image_backbone_device":"cuda:13",
            "lidar_backbone_device":"cuda:14",
            "adaptive_fusion_device":"cuda:15",
            "model_seed":101,
            "apply_adaptive_fusion":true, 
            "fusion_type":"attention",
            "num_fusion_blocks":2, 
            "weighted_fusion":false,
            "task_type":["obj_2d"]
        },
        "mlsf_mobilenet_kwargs":{
            "cfg_file":"config/mobilenetv2.cfg",
            "image_channels":3, 
            "lidar_channels":3,
            "detection_depths":["InvertedResidual_6", "InvertedResidual_12", "InvertedResidual_17"],
            "image_backbone_device":"cuda:21",
            "lidar_backbone_device":"cuda:22",
            "adaptive_fusion_device":"cuda:23",
            "model_seed":101,
            "apply_adaptive_fusion":true,
            "use_lidar_backbone":true,
            "num_fusion_blocks":2, 
            "fusion_type":"attention"
        }
    },
    "optimizer_kwargs":{
        "_description": "default_lr is for any layer other than lm",
        "_type": "AdamW", 
        "image_backbone_lr":1e-4, 
        "lidar_backbone_lr":1e-4,
        "adaptive_fusion_lr":5e-4,
        "ssd_head_lr":1e-3,
        "momentum":0.9,
        "weight_decay":0.9, 
        "tune_lidar_backbone":true,
        "tune_image_backbone":true
    },
    "lr_scheduler_kwargs":{
        "_type":"cosine",
        "linear_lr_kwargs":{
            "start_factor":1.0,
            "end_factor":0.01
        },
        "cosine_annealing_lr_kwargs":{
            "eta_min":1e-5
        }
    },
    "trainer_kwargs":{
        "output_dir": "MLSF-YOLOv3-NuScenes-numClasses-3",
        "is_training":true,
        "first_val_epoch": 0,
        "metric_eval_mode": "strict",
        "metric_average_mode": "macro",
        "epochs": 50,
        "monitor_train": true,
        "monitor_val": true,
        "gradient_clipping": 1.0,
        "checkpoint_idx":10,
        "gradient_accumulation_steps":4,
        "p_modality_dropout":0.3,
        "modality_dropout":false,
        "modality_corrupt":false,
        "robustness_augmentations":["SaltPapperNoise", "pixelate"]
    }
}